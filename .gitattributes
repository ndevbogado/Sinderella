# ============================================================
# .gitattributes - Equipo mixto Linux (SteamOS/Ubuntu) + Windows
# ============================================================

# --- Fin de linea: SIEMPRE LF en el repo, en todos los sistemas ---
* text=auto eol=lf

# --- Archivos de texto de Godot ---
*.gd         text
*.gdshader   text
*.gdshaderinc text
*.tscn       text
*.tres       text
*.godot      text
*.cfg        text
*.import     text
*.uid        text
*.gdignore   text

# --- Otros archivos de texto ---
*.md         text
*.json       text
*.yml        text
*.yaml       text
*.svg        text
*.gltf       text
*.py         text
*.sh         text eol=lf

# --- Scripts de Windows (necesitan CRLF) ---
*.bat        text eol=crlf
*.cmd        text eol=crlf

# --- Archivos binarios (Git no debe intentar convertirlos ni mostrar diffs) ---
*.png        binary
*.jpg        binary
*.jpeg       binary
*.webp       binary
*.ico        binary
*.icns       binary
*.ogg        binary
*.wav        binary
*.mp3        binary
*.flac       binary
*.mp4        binary
*.webm       binary
*.ttf        binary
*.otf        binary
*.woff2      binary
*.glb        binary
*.fbx        binary
*.blend      binary
*.psd        binary
*.kra        binary
*.xcf        binary
*.aseprite   binary
*.zip        binary
*.7z         binary

